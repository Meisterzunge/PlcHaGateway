      <Get Name="Get" Id="{e1f2a3b4-c5d6-4e7f-8a9b-0c1d2e3f4a5b}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[Value := dtmVal;]]></ST>
