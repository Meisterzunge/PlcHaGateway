  <POU Name="FB_Mfr_WeatherForecast" Id="{b7e45e17-6031-45f8-80a5-a5e6f9deec88}" SpecialFunc="None">
    <Declaration><![CDATA[/// Forecast weather extension (period low, precipitation probability, day/night slot).
FUNCTION_BLOCK FB_Mfr_WeatherForecast EXTENDS FB_Mfr_Weather IMPLEMENTS I_Mfr_WeatherForecast
VAR_OUTPUT
	fTempLw : REAL; // Period low temperature [°C]
	fPrecProb : REAL; // Precipitation probability [%]
	bDay : BOOL; // TRUE = daytime slot, FALSE = night slot
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();
]]></ST>
    </Implementation>
    <Property Name="IsDaytime" Id="{fdb3bd7a-ccf8-41c3-bd1e-2d20003afedb}">
