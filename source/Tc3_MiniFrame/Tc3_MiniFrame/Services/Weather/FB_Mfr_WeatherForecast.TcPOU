      <Get Name="Get" Id="{a89f49d6-cdeb-4022-9f3c-8bb34311f30d}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[IsDaytime := bDay;
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Precipitation" Id="{a4a0052d-e392-4a0f-a59e-835845370e5e}">
