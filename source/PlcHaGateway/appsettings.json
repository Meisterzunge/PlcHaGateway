{
    "Logging": {
        "LogLevel": {
            "Default": "Debug",
            "Microsoft": "Warning"
        },
        "ConsoleThemeType": "Ansi"
    },
    "NetDaemon": {
        "ApplicationConfigurationFolder": "./apps"
    },
    "CodeGeneration": {
        "Namespace": "HomeAssistantGenerated",
        "OutputFile": "HomeAssistantGenerated.cs",
        "UseAttributeBaseClasses" : "false"
    },
    "Mqtt": {
        "Host": "__hostname__"
    },
    "Export": {
        "Hmi": {
            "Enable": true,
            "Image": "/local/hmi.{0}.svg",
            "Stylesheet": "/local/hmi.css"
        },
        "Mapping": {
            "Enable": true
        }
    },
    
    "CyclicUpdate": 5
}
